<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VelocityDM.Mac</RootNamespace>
    <AssemblyName>VelocityDM</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VelocityDM.Core\VelocityDM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VelocityDM.App\Helpers\BridgeCommand.cs" Link="Helpers\BridgeCommand.cs" />
    <Compile Include="..\VelocityDM.App\Helpers\BrowserBridgeServer.cs" Link="Helpers\BrowserBridgeServer.cs" />
    <Compile Include="..\VelocityDM.App\Helpers\ByteFormatter.cs" Link="Helpers\ByteFormatter.cs" />
    <Compile Include="..\VelocityDM.App\ViewModels\ObservableObject.cs" Link="ViewModels\ObservableObject.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\VelocityDM.App\Assets\VelocityDM.png" Link="Assets\VelocityDM.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\extension\chrome\manifest.json" LogicalName="VelocityDM.Extension.manifest.json" />
    <EmbeddedResource Include="..\..\extension\chrome\background.js" LogicalName="VelocityDM.Extension.background.js" />
    <EmbeddedResource Include="..\..\extension\chrome\popup.html" LogicalName="VelocityDM.Extension.popup.html" />
    <EmbeddedResource Include="..\..\extension\chrome\popup.js" LogicalName="VelocityDM.Extension.popup.js" />
    <EmbeddedResource Include="..\..\extension\chrome\icon128.png" LogicalName="VelocityDM.Extension.icon128.png" />
  </ItemGroup>

</Project>
