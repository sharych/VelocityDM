<Window x:Class="VelocityDM.App.Views.BatchImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Link Import &amp; Wildcard Expander"
        Icon="pack://application:,,,/VelocityDM;component/Assets/VelocityDM.ico"
        Width="700"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Paste URLs (one per line) or use IDM-style wildcard patterns like https://example.com/part[01-10].zip"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" />
        </StackPanel>

        <TextBox x:Name="RawUrlsTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextChanged="RawUrlsTextBox_TextChanged" />

        <Grid Grid.Row="2" Margin="0,12,0,6">
            <TextBlock x:Name="PreviewHeaderText"
                       Text="Expanded Links Preview (0)"
                       Foreground="{StaticResource AccentCyanBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select All" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="SelectAll_Click" />
                <Button Content="Clear Selection" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Click="SelectNone_Click" />
            </StackPanel>
        </Grid>

        <ListBox x:Name="PreviewListBox"
                 Grid.Row="3"
                 Background="{StaticResource BgSurfaceBrush}"
                 BorderBrush="{StaticResource BorderBrushSubtle}"
                 BorderThickness="1"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Url}" Margin="4,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Save Folder (leave default to auto-categorize)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="CustomDirTextBox" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Browse..."
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,0"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Browse_Click" />
            <StackPanel Grid.Column="3">
                <TextBlock x:Name="ConnLabel" Text="Connections: 32" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <Slider x:Name="ConnectionsSlider"
                        Minimum="1"
                        Maximum="32"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="ConnectionsSlider_ValueChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" MinWidth="90" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Queue Selected (Paused)" Style="{StaticResource ToolbarButtonStyle}" MinWidth="150" Margin="0,0,10,0" Click="QueuePaused_Click" />
            <Button Content="Start Selected Downloads" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" IsDefault="True" Click="StartNow_Click" />
        </StackPanel>
    </Grid>
</Window>
