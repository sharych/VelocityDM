<Window x:Class="VelocityDM.App.Views.ChromeExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chrome Extension Integration Setup"
        Icon="pack://application:,,,/Assets/VelocityDM.ico"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgWindowBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Integrate VelocityDM with Google Chrome / Edge"
                   FontSize="17"
                   FontWeight="Bold"
                   Margin="0,0,0,6" />
        <TextBlock Grid.Row="1"
                   Text="Capture downloads directly from Chrome (including right-click 'Download with VelocityDM') and auto-launch VelocityDM even when closed."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="NativeHostStatusText" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Extension Folder (extracted &amp; copied to clipboard automatically):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="ExtPathTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8" />
                <TextBlock Text="Pinned Extension ID: pcegcihecngonbfglmjgobmlafofmchk" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Quick Setup Steps (Chrome requires user confirmation for unpacked extensions):" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="1. Click 'Install Host &amp; Open Chrome Extensions' below — this registers Chrome Native Messaging, extracts the extension, and copies its path." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="2. In the chrome://extensions tab, toggle 'Developer mode' ON (top-right)." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="3. Click 'Load unpacked', press Ctrl+V to paste the folder path, and click Select Folder." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open Folder" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0" Click="OpenFolder_Click" />
            <Button Content="Close" Style="{StaticResource ToolbarButtonStyle}" MinWidth="85" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Install Host &amp; Open Chrome Extensions" Style="{StaticResource PrimaryButtonStyle}" Click="SetupAndOpenChrome_Click" />
        </StackPanel>
    </Grid>
</Window>
