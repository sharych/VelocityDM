<Window x:Class="VelocityDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VelocityDM — Parallel Download Manager"
        Icon="pack://application:,,,/Assets/VelocityDM.ico"
        Width="1220"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="+ Add URL"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="AddUrl_Click" />
                    <Button Content="Batch Import"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,14,0"
                            Click="BatchImport_Click" />
                    <Button Content="▶ Resume"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ResumeSelected_Click" />
                    <Button Content="⏸ Pause"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,14,0"
                            Click="PauseSelected_Click" />
                    <Button Content="Resume All"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ResumeAll_Click" />
                    <Button Content="Pause All"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,14,0"
                            Click="PauseAll_Click" />
                    <Button Content="Remove"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,14,0"
                            Click="RemoveSelected_Click" />
                    <Button Content="⚙ Settings"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Settings_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Filter:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="220"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search downloads by file name, URL, or category" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Clipboard URL Capture Banner -->
        <Border Grid.Row="1"
                Background="#172554"
                BorderBrush="{StaticResource AccentCyanBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="{Binding HasClipboardBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Download Now"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="ClipboardDownloadNow_Click" />
                    <Button Content="Customize..."
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="ClipboardCustomize_Click" />
                    <Button Content="Dismiss"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Click="ClipboardDismiss_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CLIPBOARD LINK DETECTED:"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PendingClipboardUrl}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="640" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Sidebar + Download Table & Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="8,0,0,6" />

                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" IsChecked="True" Tag="All" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="All Downloads" />
                                <TextBlock Text="{Binding AllCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Downloading" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Downloading" />
                                <TextBlock Text="{Binding DownloadingCount}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Queued" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Queued" />
                                <TextBlock Text="{Binding QueuedCount}" HorizontalAlignment="Right" Foreground="{StaticResource AccentCyanBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Paused" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Paused" />
                                <TextBlock Text="{Binding PausedCount}" HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Completed" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Completed" />
                                <TextBlock Text="{Binding CompletedCount}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Error" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Errors" />
                                <TextBlock Text="{Binding ErrorCount}" HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}" />
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="CATEGORIES"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="8,18,0,6" />

                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Programs" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Programs" />
                                <TextBlock Text="{Binding ProgramsCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Compressed" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Compressed" />
                                <TextBlock Text="{Binding CompressedCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Video" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Video" />
                                <TextBlock Text="{Binding VideoCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Music" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Music" />
                                <TextBlock Text="{Binding MusicCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Documents" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Documents" />
                                <TextBlock Text="{Binding DocumentsCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Images" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Images" />
                                <TextBlock Text="{Binding ImagesCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Other" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Other" />
                                <TextBlock Text="{Binding OtherCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Content: Downloads DataGrid + Bottom Details / Parallel Segments Panel -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="240" MinHeight="160" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="DownloadsGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          MouseDoubleClick="DownloadsGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Start / Resume" Click="ResumeSelected_Click" />
                            <MenuItem Header="Force Start (Bypass Queue)" Click="ForceStartSelected_Click" />
                            <MenuItem Header="Pause" Click="PauseSelected_Click" />
                            <Separator />
                            <MenuItem Header="Move Up in Queue" Click="MoveUp_Click" />
                            <MenuItem Header="Move Down in Queue" Click="MoveDown_Click" />
                            <Separator />
                            <MenuItem Header="Open File" Click="OpenFile_Click" />
                            <MenuItem Header="Open Containing Folder" Click="OpenFolder_Click" />
                            <MenuItem Header="Copy Download URL" Click="CopyUrl_Click" />
                            <MenuItem Header="Compute / Verify SHA-256" Click="VerifySha256_Click" />
                            <Separator />
                            <MenuItem Header="Remove from List (Keep File)" Click="RemoveKeepFile_Click" />
                            <MenuItem Header="Remove &amp; Delete Local File" Click="RemoveDeleteFile_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="240" />
                        <DataGridTextColumn Header="Size" Binding="{Binding DownloadedText}" Width="140" />
                        <DataGridTemplateColumn Header="Progress" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="18"
                                                     Background="#0F172A"
                                                     Foreground="{Binding StatusBrush}"
                                                     BorderBrush="{StaticResource BorderBrushSubtle}"
                                                     BorderThickness="1" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="95" />
                        <DataGridTextColumn Header="Conns" Binding="{Binding ConnectionsText}" Width="75" />
                        <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="75" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="95" />
                        <DataGridTextColumn Header="Added" Binding="{Binding AddedAtText}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Cursor="SizeNS" />

                <!-- Bottom Details & Live Parallel Segments Inspector -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selected Download Metadata -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="DOWNLOAD DETAILS"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName, TargetNullValue=Select a download to inspect details}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="URL: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Run Text="{Binding Url, Mode=OneWay}" Foreground="{StaticResource AccentCyanBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="Save Path: " />
                                        <Run Text="{Binding TargetFilePath, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4">
                                        <Run Text="Mode: " />
                                        <Run Text="{Binding RangeSupportText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="SHA-256: " />
                                        <Run Text="{Binding HashSummaryText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open File" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="OpenFile_Click" />
                                <Button Content="Open Folder" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="OpenFolder_Click" />
                                <Button Content="Verify SHA-256" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Click="VerifySha256_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Live Parallel Segments Map -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="PARALLEL SEGMENTS MAP"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionsText}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <!-- IDM-style side-by-side visual segment progress strip -->
                            <Border Grid.Row="1"
                                    Background="#0F172A"
                                    BorderBrush="{StaticResource BorderBrushSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3"
                                    Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="14"
                                                         Margin="1,0"
                                                         Background="#1E293B"
                                                         Foreground="{Binding StatusBrush}"
                                                         BorderThickness="0"
                                                         ToolTip="{Binding ProgressText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Detailed Segment Rows -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Header}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding RangeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="10" Margin="6,0" Background="#0F172A" Foreground="{Binding StatusBrush}" BorderThickness="0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding SpeedText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Speed:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding TotalSpeedText}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <TextBlock Text="Speed Limit:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="115"
                              ItemsSource="{Binding SpeedPresets}"
                              SelectedItem="{Binding SelectedSpeedLimit, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Margin="0,0,16,0" />

                    <CheckBox Content="Clipboard Watch"
                              IsChecked="{Binding ClipboardMonitorEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <Button Content="Open Downloads Folder"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Click="OpenDefaultFolder_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBarSummary}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="   " />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
