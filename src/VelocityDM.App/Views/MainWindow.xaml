<Window x:Class="VelocityDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VelocityDM — Parallel Download &amp; Torrent Manager"
        Icon="pack://application:,,,/VelocityDM;component/Assets/VelocityDM.ico"
        Width="1260"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="+ Add URL"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,6,0"
                            Click="AddUrl_Click" />
                    <Button Content="+ Torrent"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="AddTorrent_Click" />
                    <Button Content="Batch Import"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,12,0"
                            Click="BatchImport_Click" />
                    <Button Content="▶ Resume"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ResumeSelected_Click" />
                    <Button Content="⏸ Pause"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,12,0"
                            Click="PauseSelected_Click" />
                    <Button Content="Resume All"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ResumeAll_Click" />
                    <Button Content="Pause All"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,12,0"
                            Click="PauseAll_Click" />
                    <Button Content="Remove"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,12,0"
                            Click="RemoveSelected_Click" />
                    <Button Content="Chrome Ext"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ChromeExtension_Click" />
                    <Button Content="⚙ Settings"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Settings_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Filter:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="200"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search downloads or torrents" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Clipboard Capture Banner -->
        <Border Grid.Row="1"
                Background="#172554"
                BorderBrush="{StaticResource AccentCyanBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="{Binding HasClipboardBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Download Now"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="ClipboardDownloadNow_Click" />
                    <Button Content="Customize..."
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Click="ClipboardCustomize_Click" />
                    <Button Content="Dismiss"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Click="ClipboardDismiss_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClipboardBannerLabel}"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PendingClipboardUrl}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="640" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarStack">
                        <TextBlock Text="HTTP DOWNLOADS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="8,0,0,6" />

                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" IsChecked="True" Tag="All" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="All Downloads" />
                                <TextBlock Text="{Binding AllCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Downloading" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Downloading" />
                                <TextBlock Text="{Binding DownloadingCount}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Queued" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Queued" />
                                <TextBlock Text="{Binding QueuedCount}" HorizontalAlignment="Right" Foreground="{StaticResource AccentCyanBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Paused" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Paused" />
                                <TextBlock Text="{Binding PausedCount}" HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Completed" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Completed" />
                                <TextBlock Text="{Binding CompletedCount}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Error" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Errors" />
                                <TextBlock Text="{Binding ErrorCount}" HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}" />
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="TORRENTS"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="8,16,0,6" />

                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="TorrentsAll" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="All Torrents" />
                                <TextBlock Text="{Binding TorrentsAllCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="TorrentsDownloading" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Downloading" />
                                <TextBlock Text="{Binding TorrentsDownloadingCount}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="TorrentsSeeding" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Seeding" />
                                <TextBlock Text="{Binding TorrentsSeedingCount}" HorizontalAlignment="Right" Foreground="{StaticResource AccentCyanBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="TorrentsPaused" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Paused / Stopped" />
                                <TextBlock Text="{Binding TorrentsPausedCount}" HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" />
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="CATEGORIES"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="8,16,0,6" />

                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Programs" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Programs" />
                                <TextBlock Text="{Binding ProgramsCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Compressed" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Compressed" />
                                <TextBlock Text="{Binding CompressedCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Video" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Video" />
                                <TextBlock Text="{Binding VideoCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Music" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Music" />
                                <TextBlock Text="{Binding MusicCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Documents" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Documents" />
                                <TextBlock Text="{Binding DocumentsCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Images" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Images" />
                                <TextBlock Text="{Binding ImagesCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarRadioStyle}" GroupName="Sidebar" Tag="Other" Checked="SidebarFilter_Checked">
                            <Grid>
                                <TextBlock Text="Other" />
                                <TextBlock Text="{Binding OtherCount}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- HTTP View -->
            <Grid Grid.Column="1" Margin="10" Visibility="{Binding IsHttpView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="240" MinHeight="160" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="DownloadsGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          MouseDoubleClick="DownloadsGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Start / Resume" Click="ResumeSelected_Click" />
                            <MenuItem Header="Force Start (Bypass Queue)" Click="ForceStartSelected_Click" />
                            <MenuItem Header="Pause" Click="PauseSelected_Click" />
                            <Separator />
                            <MenuItem Header="Move Up in Queue" Click="MoveUp_Click" />
                            <MenuItem Header="Move Down in Queue" Click="MoveDown_Click" />
                            <Separator />
                            <MenuItem Header="Open File" Click="OpenFile_Click" />
                            <MenuItem Header="Open Containing Folder" Click="OpenFolder_Click" />
                            <MenuItem Header="Copy Download URL" Click="CopyUrl_Click" />
                            <MenuItem Header="Compute / Verify SHA-256" Click="VerifySha256_Click" />
                            <Separator />
                            <MenuItem Header="Remove from List (Keep File)" Click="RemoveKeepFile_Click" />
                            <MenuItem Header="Remove &amp; Delete Local File" Click="RemoveDeleteFile_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Size" Binding="{Binding DownloadedText}" Width="125" />
                        <DataGridTemplateColumn Header="Progress" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="18"
                                                     Background="#0F172A"
                                                     Foreground="{Binding StatusBrush}"
                                                     BorderBrush="{StaticResource BorderBrushSubtle}"
                                                     BorderThickness="1" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="88" />
                        <DataGridTextColumn Header="Conns" Binding="{Binding ConnectionsText}" Width="66" />
                        <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="62" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="92" />
                        <DataGridTextColumn Header="Added" Binding="{Binding AddedAtText}" Width="116" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Cursor="SizeNS" />

                <!-- Bottom HTTP Details & Parallel Segments Map -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="DOWNLOAD DETAILS"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName, TargetNullValue=Select a download to inspect details}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="URL: " />
                                        <Run Text="{Binding Url, Mode=OneWay}" Foreground="{StaticResource AccentCyanBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="Save Path: " />
                                        <Run Text="{Binding TargetFilePath, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4">
                                        <Run Text="Mode: " />
                                        <Run Text="{Binding RangeSupportText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="SHA-256: " />
                                        <Run Text="{Binding HashSummaryText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open File" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="OpenFile_Click" />
                                <Button Content="Open Folder" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="OpenFolder_Click" />
                                <Button Content="Verify SHA-256" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Click="VerifySha256_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="PARALLEL SEGMENTS MAP"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionsText}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#0F172A"
                                    BorderBrush="{StaticResource BorderBrushSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3"
                                    Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="14"
                                                         Margin="1,0"
                                                         Background="#1E293B"
                                                         Foreground="{Binding StatusBrush}"
                                                         BorderThickness="0"
                                                         ToolTip="{Binding ProgressText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Header}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding RangeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="10" Margin="6,0" Background="#0F172A" Foreground="{Binding StatusBrush}" BorderThickness="0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding SpeedText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Torrents View -->
            <Grid Grid.Column="1" Margin="10" Visibility="{Binding IsTorrentView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="240" MinHeight="160" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="TorrentsGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding FilteredTorrents}"
                          SelectedItem="{Binding SelectedTorrent, Mode=TwoWay}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Start / Resume Torrent" Click="ResumeSelected_Click" />
                            <MenuItem Header="Pause Torrent" Click="PauseSelected_Click" />
                            <MenuItem Header="Toggle Sequential Order" Click="ToggleTorrentSequential_Click" />
                            <Separator />
                            <MenuItem Header="Open Save Folder" Click="OpenFolder_Click" />
                            <MenuItem Header="Copy Magnet Link" Click="CopyMagnet_Click" />
                            <Separator />
                            <MenuItem Header="Remove Torrent (Keep Files)" Click="RemoveKeepFile_Click" />
                            <MenuItem Header="Remove Torrent &amp; Delete Data" Click="RemoveDeleteFile_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Torrent Name" Binding="{Binding Name}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeSummaryText}" Width="140" />
                        <DataGridTemplateColumn Header="Progress" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="18"
                                                     Background="#0F172A"
                                                     Foreground="{Binding StatusBrush}"
                                                     BorderBrush="{StaticResource BorderBrushSubtle}"
                                                     BorderThickness="1" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Down Speed" Binding="{Binding DownloadSpeedText}" Width="95" />
                        <DataGridTextColumn Header="Up Speed" Binding="{Binding UploadSpeedText}" Width="95" />
                        <DataGridTextColumn Header="Peers (S/L)" Binding="{Binding PeersSummaryText}" Width="110" />
                        <DataGridTextColumn Header="Ratio" Binding="{Binding RatioText}" Width="65" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Cursor="SizeNS" />

                <!-- Torrent Details & Files List -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedTorrent}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TORRENT DETAILS"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, TargetNullValue=Select a torrent to inspect details}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="InfoHash: " />
                                        <Run Text="{Binding InfoHashHex, Mode=OneWay}" Foreground="{StaticResource AccentCyanBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                        <Run Text="Save Folder: " />
                                        <Run Text="{Binding SaveDirectory, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4">
                                        <Run Text="Sequential Order: " />
                                        <Run Text="{Binding Sequential, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open Folder" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="OpenFolder_Click" />
                                <Button Content="Copy Magnet" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0" Click="CopyMagnet_Click" />
                                <Button Content="Toggle Sequential" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Click="ToggleTorrentSequential_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid DataContext="{Binding SelectedTorrent}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TORRENT FILES (Right-click file to change priority)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <DataGrid x:Name="TorrentFilesGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Files}"
                                      RowHeight="30">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Priority: High" Tag="High" Click="SetTorrentFilePriority_Click" />
                                        <MenuItem Header="Priority: Normal" Tag="Normal" Click="SetTorrentFilePriority_Click" />
                                        <MenuItem Header="Priority: Low" Tag="Low" Click="SetTorrentFilePriority_Click" />
                                        <MenuItem Header="Skip File (Do Not Download)" Tag="DoNotDownload" Click="SetTorrentFilePriority_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                    <DataGridTextColumn Header="Done" Binding="{Binding ProgressText}" Width="65" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityText}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Speed:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding TotalSpeedText}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <TextBlock Text="HTTP Limit:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="112"
                              ItemsSource="{Binding SpeedPresets}"
                              SelectedItem="{Binding SelectedSpeedLimit, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Margin="0,0,16,0" />

                    <CheckBox Content="Clipboard Watch"
                              IsChecked="{Binding ClipboardMonitorEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <Button Content="Open Downloads Folder"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4"
                            Click="OpenDefaultFolder_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBarSummary}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="   " />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
