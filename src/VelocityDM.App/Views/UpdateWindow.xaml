<Window x:Class="VelocityDM.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VelocityDM Auto-Updater"
        Icon="pack://application:,,,/VelocityDM;component/Assets/VelocityDM.ico"
        Width="610"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgWindowBrush}">
    <Grid Margin="22" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadlineText"
                       Text="Checking GitHub Releases..."
                       FontSize="18"
                       FontWeight="Bold" />
            <TextBlock x:Name="SubheadlineText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,14,0,10">
            <StackPanel>
                <TextBlock x:Name="PackageTitleText"
                           Text="Target Package"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentCyanBrush}" />
                <TextBlock x:Name="PackageDetailsText"
                           Text="Querying latest release from github.com/sharych/VelocityDM..."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="ChromeHintText"
                           Text="After restart, Chrome extension files are updated automatically (click Reload in chrome://extensions if already loaded)."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="RELEASE NOTES"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   FontWeight="Bold"
                   Margin="0,2,0,6" />

        <TextBox Grid.Row="3"
                 x:Name="ReleaseNotesTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="12"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource BgSurfaceBrush}"
                 BorderBrush="{StaticResource BorderBrushSubtle}" />

        <StackPanel Grid.Row="4"
                    x:Name="ProgressPanel"
                    Margin="0,12,0,0"
                    Visibility="Visible">
            <ProgressBar x:Name="UpdateProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Height="8"
                         IsIndeterminate="True"
                         Background="{StaticResource BgSurfaceBrush}"
                         Foreground="{StaticResource AccentCyanBrush}" />
            <TextBlock x:Name="StatusText"
                       Text="Connecting to GitHub..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="OpenGitHubButton"
                        Content="Open on GitHub"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="OpenGitHub_Click" />
                <Button x:Name="SkipVersionButton"
                        Content="Skip This Version"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="SkipVersion_Click" />
                <Button x:Name="RecheckButton"
                        Content="Check Again"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Visibility="Collapsed"
                        Click="Recheck_Click" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CloseOrCancelButton"
                        Content="Close"
                        Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="90"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CloseOrCancel_Click" />
                <Button x:Name="InstallUpdateButton"
                        Content="Update &amp; Restart Now"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="InstallUpdate_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
