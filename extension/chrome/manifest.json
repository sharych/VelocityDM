{
  "manifest_version": 3,
  "name": "VelocityDM Download Integrator",
  "version": "2.1.0",
  "description": "Automatically send Chrome downloads and links directly to VelocityDM for multi-segment parallel downloading.",
  "key": "",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
